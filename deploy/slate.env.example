# Values for the reverse proxy in front of Slate. Copy to /etc/slate.env on
# the server, fill it in, and keep it readable by Caddy and no one else:
#
#   sudo install -o root -g caddy -m 640 slate.env /etc/slate.env
#
# The token is the whole boundary for the public endpoint — treat this file
# the way you would treat a private key.

# The name agents outside the network reach Slate at. A domain you own, with
# an A record pointing at this machine; Caddy gets the certificate for it.
SLATE_DOMAIN=slate.example.com

# The bearer token the public endpoint requires:  openssl rand -hex 32
SLATE_TOKEN=

# The private address the dashboard is served on — a VPN or VPC address,
# never a public one — and the port, which agents already in the network use.
SLATE_PRIVATE_IP=10.0.0.1
SLATE_PORT=8750

# Where Slate itself listens: the loopback, reachable by the proxy alone.
SLATE_UPSTREAM=127.0.0.1:8750
